# Falso Configuration
# Copy this file to .env and fill in your values

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=true

# --- Security ---
# Optional bearer token required for all /api/* requests.
# Leave empty for local-only use. Set it when exposing the API remotely.
# Clients send: Authorization: Bearer <token>  (or)  X-Falso-Token: <token>
API_TOKEN=
# Allowed cross-origin origins (JSON array). Same-origin is always allowed.
ALLOWED_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
# Max request body size in bytes for /api/* requests. Enforced for both
# declared Content-Length and chunked/streamed bodies (never buffered).
MAX_REQUEST_BYTES=10000000
# GPU monitor refresh interval in seconds (float > 0). nvidia-smi is probed in the
# background at this rate; /stats always serves the cached snapshot.
GPU_REFRESH_INTERVAL_SECONDS=5

# --- Logging ---
LOG_LEVEL=INFO

# --- AI Provider ---
# Chat backend for free-form prompts. Options:
#   gemini (default — Google AI Studio / Gemini API)
#   ollama (optional — local Ollama)
#   openai (optional — OpenAI cloud)
# Switching providers changes nothing in the UI — just set the name here.
AI_PROVIDER=gemini

# --- Gemini (default primary AI provider) ---
# Get a key at https://aistudio.google.com/app/apikey
# The key is read server-side only and is NEVER exposed to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama (optional local provider) ---
# Only used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- OpenAI (optional provider) ---
# Only used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

SYSTEM_PROMPT_PATH=./config/system_prompt.txt

# --- Personality Engine ---
# Personality used to build the system prompt at request time
# (default, technician, ultron, jarvis, minimal, friendly). The Personality
# Engine only produces a system prompt; it never routes tools, calls the LLM,
# or manages memory.
ASSISTANT_PERSONALITY=default
# User preferences folded into the generated system prompt.
USER_LANGUAGE=English
USER_VERBOSITY=concise

# --- Voice / ElevenLabs ---
# Get an API key at https://elevenlabs.io
# If empty or unconfigured, Falso automatically falls back to native LocalTTSEngine.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- File Tool ---
# Optional workspace directory added to the allowed sandbox
# (Documents, Desktop, Downloads are always allowed).
FILE_TOOL_WORKSPACE=
MAX_FILE_READ_BYTES=1000000
MAX_FILE_WRITE_BYTES=5000000
MAX_SEARCH_RESULTS=500
MAX_LIST_ITEMS=5000