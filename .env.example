# Falso Configuration
# Copy this file to .env and fill in your values

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=true

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Voice ---
STT_MODEL=base
TTS_VOICE=alloy

# --- Memory ---
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vision ---
TESSERACT_CMD=tesseract
